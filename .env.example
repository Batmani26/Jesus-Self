# ==============================
# Jesus Self — environment template
# Copy to .env (local) OR paste each line into
# your panel's Environment Variables section.
# ==============================

# ----- host role / sharding -----
ROLE=selfonly
SHARD=0
SHARD_TOTAL=2
DB_POOL_MIN=1
DB_POOL_MAX=4
PYTHONUNBUFFERED=1
MALLOC_ARENA_MAX=2

# ----- telegram api (from my.telegram.org) -----
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627
SESSION_NAME=jesus_self_session

# ----- neon database (shared between hosts) -----
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# ----- encryption key (MUST be identical on every host) -----
ENCRYPTION_KEY=

# ----- management bot -----
BOT_TOKEN=
ADMIN_ID=

# ----- admin telethon session -----
SESSION_STRING=

# ----- optional AI keys -----
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# ----- python -----
PYTHON_VERSION=3.11.8
